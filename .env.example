# Supabase — copy this file to `.env` and fill in the values from your project.
# Project settings → API. Leave BOTH empty to run the app in pure local mode
# (no login, data only in the browser, exactly like before).
#
# The anon (public) key is safe to expose in a front-end app: access is protected
# by Row Level Security, so each user can only read/write their own rows.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
